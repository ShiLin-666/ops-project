apiVersion: v1
kind: ConfigMap
metadata:
  name: alertmanager-config
  namespace: monitoring
data:
  alertmanager.yml: |
    global:
      smtp_smarthost: 'smtp.qq.com:465'
      smtp_from: '246499350@qq.com'
      smtp_auth_username: '246499350@qq.com'
      smtp_auth_password: 'CHANGE_ME'
      smtp_require_tls: false
    route:
      group_by: ['alertname']
      group_wait: 30s
      receiver: 'email'
    receivers:
    - name: 'email'
      email_configs:
      - to: '246499350@qq.com'
